{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/asr",
      "destination": "/api/asr.js"
    },
    {
      "source": "/api/asr-stream",
      "destination": "/api/asr-stream.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}